config UDC_NUMAKER
	bool "Nuvoton NuMaker USB device controller"
	default y
	depends on DT_HAS_NUVOTON_NUMAKER_USBD_ENABLED \
		|| DT_HAS_NUVOTON_NUMAKER_HSUSBD_ENABLED
	select PINCTRL
	select UDC_DRIVER_HAS_HIGH_SPEED_SUPPORT if DT_HAS_NUVOTON_NUMAKER_HSUSBD_ENABLED
	select EVENTS
	help
	  Enable Nuvoton NuMaker USB device controller driver

if UDC_NUMAKER

config UDC_NUMAKER_MSG_QUEUE_SIZE
	int "UDC NuMaker message queue size"
	default 32
	help
	  Maximum number of messages the driver can queue for interrupt bottom half processing.

config UDC_NUMAKER_THREAD_STACK_SIZE
	int "UDC NuMaker driver internal thread stack size"
	default 1536
	help
	  Size of the stack for the driver internal thread.

config UDC_NUMAKER_THREAD_PRIORITY
	int "UDC NuMaker driver internal thread priority"
	default 8
	help
	  Priority of the driver internal thread.

config UDC_NUMAKER_DMA
	bool "UDC NuMaker DMA support"
	default y
	depends on DT_HAS_NUVOTON_NUMAKER_HSUSBD_ENABLED
	help
	  This enables DMA transfer between user buffer and USB buffer.

config UDC_NUMAKER_DMA_TIMEOUT_MS
	int "UDC NuMaker DMA timeout"
	default 2000
	depends on UDC_NUMAKER_DMA
	help
	  This configures timeout of DMA transfer in milliseconds.

config UDC_NUMAKER_PROBE
	bool "UDC NuMaker latency probes (for throughput investigation)"
	default n
	help
	  Enable cycle-counter probes inside the IN-direction critical
	  path (xfer_in, DMA wait, msg_handle_in, ISR -> handler latency).
	  Use udc_numaker_probe_dump_to_printk() to dump histograms.
	  Adds a few atomic ops per URB; not for production builds.

config UDC_NUMAKER_FAST_IN
	bool "UDC NuMaker fast-in DMA chaining (HSUSBD)"
	default n
	depends on UDC_NUMAKER_DMA
	help
	  Pump multi-packet bulk IN URBs entirely from IRQ context: the
	  TXPKIF ISR re-arms the next DMA chunk and the DMA-done ISR
	  re-enables TXPKIEN, so the UDC thread is involved only at URB
	  start and URB completion (not per packet).  Cuts per-packet
	  software roundtrip from ~40 us to ~15 us on M487.  Only one IN
	  URB can be fast-pathed at a time; concurrent IN EPs fall back
	  to the slow path.

endif # UDC_NUMAKER
